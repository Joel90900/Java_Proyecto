# Copia este archivo como .env y completa los valores.
SECRET_KEY=cambia-esta-clave-por-una-larga-y-aleatoria
DEBUG=True

# PostgreSQL
DB_NAME=vehiculos
DB_USER=postgres
DB_PASSWORD=tu-contraseña-de-postgres
DB_HOST=127.0.0.1
DB_PORT=5432

# Hosts adicionales separados por comas (opcional), p. ej. la IP del PC en la red local
ALLOWED_HOSTS_EXTRA=
